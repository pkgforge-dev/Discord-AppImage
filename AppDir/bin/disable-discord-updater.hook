#!/bin/sh

_disable_discord_updater() {
	f=$CONFIGDIR/discord/settings.json

	if [ ! -f "$f" ]; then
		mkdir -p "${f%/*}"
		echo "{}" > "$f"
	fi

	if ! grep -q 'SKIP_HOST_UPDATE' "$f" \
	  && _f=$(jq '.SKIP_HOST_UPDATE = true' "$f"); then
		echo "$_f" > "$f"
		>&2 echo "Added 'SKIP_HOST_UPDATE = true' to $f"
	fi
}

_stage_native_modules() {
	discord_ver=$(jq -r .version "$APPDIR"/bin/resources/build_info.json)
	modules_dir=$CONFIGDIR/discord/$discord_ver/modules

	mkdir -p "$modules_dir"

	# Only refresh the symlinks to the bundled modules instead of wiping the
	# whole modules dir. Deleting it also removes Discord's pending downloads
	# while they may still be written to, which makes Discord crash with an
	# uncaught ENOENT on modules/pending/<module>-<version>.zip.
	for d in "$APPDIR"/bin/modules/*/; do
		if [ -d "$d" ]; then
			mod=${d##*/}
			rm -rf "$modules_dir"/"$mod"
			ln -sf "$d" "$modules_dir"/"$mod"
		fi
	done

	cp -f "$APPDIR"/bin/modules/installed.json "$modules_dir"/installed.json
}

_disable_discord_updater || :
_stage_native_modules || :
