#!/bin/sh

_disable_discord_updater() {
	f=$CONFIGDIR/discord/settings.json

	if [ ! -f "$f" ]; then
		mkdir -p "${f%/*}"
		echo "{}" > "$f"
	fi

	if ! grep -q 'SKIP_HOST_UPDATE' "$f" \
	  && _f=$(jq '.SKIP_HOST_UPDATE = true' "$f"); then
		echo "$_f" > "$f"
		>&2 echo "Added 'SKIP_HOST_UPDATE = true' to $f"
	fi
}

_disable_discord_updater || :
